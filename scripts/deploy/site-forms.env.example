# Скопируйте на сервер как /etc/deloresh/site-forms.env (chmod 600).
# Файл читает systemd-сервис site-forms (см. site-forms.service).

# Порт, на котором слушает Node.js API. nginx будет проксировать /api/* сюда.
DELORESH_SITE_FORMS_PORT=8787

# Каталог, куда складываются JSON и медиафайлы. Должен принадлежать тому же
# пользователю, под которым работает сервис (см. User= в site-forms.service).
DELORESH_SITE_FORMS_DATA=/var/lib/deloresh/site-forms

# Секрет для админ-скриптов / tg-bridge (заголовок X-Deloresh-Write-Secret).
# Браузерный клиент пишет через Bearer-сессию сотрудника — этот секрет
# в Vite/фронт НЕ встраиваем.
# Сгенерировать: openssl rand -hex 24
DELORESH_SITE_FORMS_WRITE_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Тот же токен, что у tg-bridge — чтобы при новом рейсе слать водителю
# сообщение в Telegram, даже если кабинет закрыт. Без токена рейс
# всё равно сохранится, просто без пуша в мессенджер.
TG_BOT_TOKEN=

# --- DWG preview (VPS ~2 ГиБ) ---
# Потолок длинной стороны PNG (раньше по умолчанию до 28672 → OOM).
DELORESH_PNG_MAX_DIMENSION=4096
# Сколько Dwg2Dxf/Dwg2Png одновременно (1 = безопасно).
DELORESH_DWG_MAX_CONCURRENT=1
# LibreDWG (WASM в Node) не трогать файлы больше этого (байты).
DELORESH_LIBRE_MAX_BYTES=8000000
