{
  "name": "deloresh-objects",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-dwg-wasm.mjs && node scripts/patch-cadview-hatch.mjs && vite --host --port 5173 --strictPort",
    "dev:site-forms-api": "node server/site-forms.mjs",
    "dev:mobile": "bash scripts/mobile-dev.sh",
    "postinstall": "node scripts/patch-cadview-hatch.mjs",
    "prebuild": "node scripts/generate-pwa-icons.mjs && node scripts/copy-dwg-wasm.mjs && node scripts/patch-cadview-hatch.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "launch": "npm run build && npm run preview",
    "generate:dwg-previews": "node scripts/generate-dwg-previews.mjs",
    "deploy:server": "bash scripts/deploy/from-mac.sh"
  },
  "dependencies": {
    "@cadview/core": "^0.5.0",
    "@cadview/dwg": "^0.2.0",
    "@cadview/react": "^0.5.0",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  }
}
